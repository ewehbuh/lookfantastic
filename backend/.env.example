# Set these in the deployment environment. Django does not load this file automatically.
DJANGO_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Activate methods in Stripe Dashboard; choose methods supported by your account/currency.
# Examples: sepa_debit (EUR), bacs_debit (GBP), us_bank_account (USD).
STRIPE_BANK_PAYMENT_METHOD_TYPES=
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=gbp
PAYMENT_FRONTEND_URL=http://localhost:3000
# Google web OAuth: configure redirect URI identically in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Return eligibility window after recorded delivery (or order creation).
RETURNS_WINDOW_DAYS=30

# Maximum age of staff-managed FX rates, in seconds
FX_MAX_AGE_SECONDS=86400
